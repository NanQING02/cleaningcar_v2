{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "CleaningCar v2 当前运行流程",
    "locale": "zh-CN",
    "animation": "none",
    "quality_profile": "showcase",
    "views": [
      {
